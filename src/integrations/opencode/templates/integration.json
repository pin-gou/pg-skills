    "action.subagent_dispatcher": "Task tool",
    "action.subagent_call": "task",
    "action.subagent_agent_parameter": "subagent_type",
    "action.user_question": "question tool",
    "action.user_question_call": "question",
    "action.task_tracker": "TodoWrite",
    "action.agent_cli": "opencode run --agent",
    "action.agent_cli_argv_json": "[\"opencode\", \"run\", \"--agent\"]",
    "permission.subagent": "task",
    "model.associate": "pg-router/pg-associate",
    "model.expert": "pg-router/pg-expert",
    "model.master": "pg-router/pg-master"
  }
