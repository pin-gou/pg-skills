{
  "schema_version": 1,
  "tool": "opencode",
  "output_root": ".opencode",
  "install_mode": "render",
  "surfaces": {
    "commands": "commands",
    "agents": "agents",
    "skills": "skills"
  },
  "template_variables": {
    "tool.name": "OpenCode",
    "tool.config_file": "opencode.json",
    "tool.chrome_path_reference": "{env:CHROME_PATH}",
